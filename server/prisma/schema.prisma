// SYNCREW 서버 스키마. 테이블 설계: docs/database-design.md
// Phase 1: openai_usage / Phase 2: 프로필·현장·멤버십·가입 코드·그룹 대화 / Phase 4: 메시지·번역·수신자
// Phase 5: 실시간 통역 세션 (1:1 통화, 관리자 일괄 지시)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// OpenAI 호출 1건의 사용량과 추정 비용. 비용 한도(BudgetGuard)의 기준 데이터.
model OpenAiUsage {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// stt | translate
  kind              String
  model             String
  inputTextTokens   Int      @default(0) @map("input_text_tokens")
  inputAudioTokens  Int      @default(0) @map("input_audio_tokens")
  cachedInputTokens Int      @default(0) @map("cached_input_tokens")
  outputTextTokens  Int      @default(0) @map("output_text_tokens")
  outputAudioTokens Int      @default(0) @map("output_audio_tokens")
  costUsd           Decimal  @map("cost_usd") @db.Decimal(12, 6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("openai_usage")
}

/// Supabase auth.users 와 1:1 (id = Supabase user id). 다른 DB라 외래 키는 걸지 않는다.
model Profile {
  id            String    @id @db.Uuid
  email         String
  displayName   String    @map("display_name")
  preferredLang String    @map("preferred_lang")
  autoPlay      Boolean   @default(true) @map("auto_play")
  speechRate    Float     @default(1) @map("speech_rate") @db.Real
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships SiteMembership[] @relation("member")

  @@map("profiles")
}

model Site {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  address   String?
  /// active | archived
  status    String   @default("active")
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships   SiteMembership[]
  joinCodes     SiteJoinCode[]
  conversations Conversation[]
  messages      Message[]
  liveSessions  LiveSession[]

  @@map("sites")
}

model SiteMembership {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId       String    @map("site_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// manager | member
  role         String
  /// pending | active | rejected | removed
  status       String
  langOverride String?   @map("lang_override")
  decidedBy    String?   @map("decided_by") @db.Uuid
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  site Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user Profile @relation("member", fields: [userId], references: [id])

  @@unique([siteId, userId])
  @@index([userId, status])
  @@index([siteId, status])
  @@map("site_memberships")
}

model SiteJoinCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId    String    @map("site_id") @db.Uuid
  code      String    @unique
  createdBy String    @map("created_by") @db.Uuid
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  maxUses   Int?      @map("max_uses")
  useCount  Int       @default(0) @map("use_count")
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("site_join_codes")
}

model Conversation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId        String    @map("site_id") @db.Uuid
  /// direct | group
  type          String
  /// direct: "작은uuid:큰uuid"
  directKey     String?   @map("direct_key")
  title         String?
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  site         Site                      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]
  liveSessions LiveSession[]

  @@index([siteId])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt         DateTime? @map("left_at") @db.Timestamptz(6)
  /// 마지막으로 읽은 메시지 seq (안 읽은 수 계산용)
  lastReadSeq    BigInt    @default(0) @map("last_read_seq")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

/// 1:1·그룹·일괄 지시 메시지. 생성 시 번역(언어별)·수신자 행을 한 트랜잭션으로 만든다.
model Message {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId          String    @map("site_id") @db.Uuid
  /// instruction 이면 NULL
  conversationId  String?   @map("conversation_id") @db.Uuid
  /// direct | group | instruction
  kind            String
  senderId        String    @map("sender_id") @db.Uuid
  clientMessageId String    @map("client_message_id")
  seq             BigInt    @default(autoincrement())
  /// text | audio
  inputType       String    @map("input_type")
  /// 음성 입력 원본 파일 (storage/uploads/...). 재시도 시 다시 인식한다.
  inputAudioPath  String?   @map("input_audio_path")
  sourceLang      String    @map("source_lang")
  /// 입력 텍스트 또는 STT 결과
  rawText         String?   @map("raw_text")
  /// 현장 특화 보정 결과
  correctedText   String?   @map("corrected_text")
  glossaryHits    Json      @default("[]") @map("glossary_hits")
  requiresAck     Boolean   @default(false) @map("requires_ack")
  /// queued | processing | done | partially_failed | failed
  status          String    @default("queued")
  errorCode       String?   @map("error_code")
  /// 단계별 처리 시간(ms): decode, preprocess, stt, domain
  timings         Json?
  /// 실시간 통역 세션 중 발화면 그 세션 (1:1 통화 → direct, 일괄 지시 → instruction)
  sessionId       String?   @map("session_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  site         Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  conversation Conversation?        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  session      LiveSession?         @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  translations MessageTranslation[]
  recipients   MessageRecipient[]

  @@unique([senderId, clientMessageId])
  @@index([conversationId, seq])
  @@index([siteId, kind, createdAt])
  @@index([status])
  @@index([sessionId, seq])
  @@map("messages")
}

/// 대상 언어별 번역 1행. 같은 언어 수신자는 이 행을 공유한다.
model MessageTranslation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId      String    @map("message_id") @db.Uuid
  targetLang     String    @map("target_lang")
  /// pending | processing | done | failed | skipped
  status         String    @default("pending")
  /// skipped 면 NULL (원문 사용)
  translatedText String?   @map("translated_text")
  /// storage/audio 기준 상대 경로
  audioPath      String?   @map("audio_path")
  model          String?
  attempts       Int       @default(0)
  latencyMs      Int?      @map("latency_ms")
  timings        Json?
  errorCode      String?   @map("error_code")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, targetLang])
  @@map("message_translations")
}

/// 수신자별 전달 상태 1행.
model MessageRecipient {
  messageId      String    @map("message_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// 발신 시점의 수신자 언어 (스냅샷)
  targetLang     String    @map("target_lang")
  /// pending | sent | delivered | acknowledged | completed | failed
  status         String    @default("pending")
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(6)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(6)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  responseNote   String?   @map("response_note")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, status])
  @@index([userId, updatedAt])
  @@map("message_recipients")
}

/// 실시간 통역 세션. call: 1:1 통역 통화 / broadcast: 관리자 → 여러 구성원 일괄 지시
model LiveSession {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId         String    @map("site_id") @db.Uuid
  /// call | broadcast
  mode           String
  /// ringing | active | ended
  status         String
  /// call 이면 두 사람의 1:1 대화 (발화가 이 대화의 메시지로 저장된다)
  conversationId String?   @map("conversation_id") @db.Uuid
  startedBy      String    @map("started_by") @db.Uuid
  /// hangup | declined | missed | cancelled | connection_lost | removed
  endReason      String?   @map("end_reason")
  endedBy        String?   @map("ended_by") @db.Uuid
  answeredAt     DateTime? @map("answered_at") @db.Timestamptz(6)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  site         Site                     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  conversation Conversation?            @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  participants LiveSessionParticipant[]
  messages     Message[]

  @@index([siteId, mode, createdAt])
  @@index([status])
  @@map("live_sessions")
}

/// 세션 참여자. call: caller·callee / broadcast: speaker(관리자)·listener(수신 대상)
model LiveSessionParticipant {
  sessionId String    @map("session_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// caller | callee | speaker | listener
  role      String
  joinedAt  DateTime? @map("joined_at") @db.Timestamptz(6)
  leftAt    DateTime? @map("left_at") @db.Timestamptz(6)

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
  @@index([userId])
  @@map("live_session_participants")
}
