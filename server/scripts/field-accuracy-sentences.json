    { "id": "s005", "cat": "slang", "text": "삼 층 슬래브에 사뽀도 더 세워", "terms": ["사뽀도"], "meaning": "3층 슬래브에 서포트(동바리)를 더 세워라" },
    { "id": "s006", "cat": "slang", "text": "하이바 안 쓰면 현장에 못 들어와", "terms": ["하이바"], "meaning": "안전모를 안 쓰면 현장에 못 들어온다" },
    { "id": "s007", "cat": "slang", "text": "공구리 치기 전에 철근 간격 다시 봐", "terms": ["공구리"], "meaning": "콘크리트 타설 전에 철근 간격을 다시 확인해라" },
