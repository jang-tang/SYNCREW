    { "id": "s009", "cat": "slang", "text": "계단은 오도리바까지만 시아게 해 주세요", "terms": ["오도리바", "시아게"], "meaning": "계단은 계단참까지만 마감해 주세요" },
    { "id": "s010", "cat": "slang", "text": "이거 아다라시로 바꿔 와", "terms": ["아다라시"], "meaning": "이것을 새것(신품)으로 바꿔 와라" },
    { "id": "s011", "cat": "slang", "text": "타일은 이모메지로 붙이세요", "terms": ["이모메지"], "meaning": "타일은 통줄눈으로 붙이세요" },
    { "id": "s012", "cat": "slang", "text": "야리가다 다시 확인하고 먹 놓으세요", "terms": ["야리가다"], "meaning": "규준틀을 다시 확인하고 먹줄을 놓으세요" },
    { "id": "s013", "cat": "slang", "text": "오늘 바라시 작업 있으니까 밑에 통행 막아", "terms": ["바라시"], "meaning": "오늘 해체 작업이 있으니 아래 통행을 막아라" },
    { "id": "s014", "cat": "slang", "text": "스지까이 빠진 데 있으면 바로 보강해", "terms": ["스지까이"], "meaning": "가새가 빠진 곳이 있으면 바로 보강해라" },
    { "id": "s015", "cat": "slang", "text": "데스리 없는 쪽으로는 절대 가지 마", "terms": ["데스리"], "meaning": "난간이 없는 쪽으로는 절대 가지 마라" },
