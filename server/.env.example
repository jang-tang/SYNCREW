# ─── 서버 ───────────────────────────────────────────
NODE_ENV=development
# 휴대폰(같은 Wi-Fi)에서 접속하려면 0.0.0.0 유지
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# ─── 데이터베이스 (npm run db:start 로 띄우는 로컬 Postgres) ───
DATABASE_URL=postgresql://syncrew:syncrew@localhost:5433/syncrew

# ─── OpenAI ─────────────────────────────────────────
# 직접 입력하거나 `npm run setup:openai` 로 입력하세요. 비워 두면 통역 기능만 비활성화됩니다.
OPENAI_API_KEY=
# 비용 한도 (USD). 한도를 넘는 호출은 서버가 거부합니다.
OPENAI_BUDGET_USD=5
# month: 매월 1일(UTC) 초기화 / total: 누적
OPENAI_BUDGET_PERIOD=month
# 단가 덮어쓰기 (선택, USD per 1M tokens). 예: {"gpt-realtime-2.1":{"inputText":4,"outputText":24,"inputAudio":32,"outputAudio":64,"cachedInput":0.4}}
OPENAI_PRICING_JSON=
STT_MODEL=gpt-4o-transcribe
# 스트리밍 전사 전용 세션 모델: gpt-live-transcribe(기본, VAD 없이 말하는 도중 원문 조각, $0.017/분) | gpt-4o-transcribe(server_vad, 말 끝 뒤 조각, $0.006/분)
STREAM_STT_MODEL=gpt-live-transcribe
TRANSLATION_MODEL=gpt-realtime-2.1
# openai: 실제 통역 / fake: 키 없이 개발용 가짜 통역 ("[vi] 원문" 형식, 비용 없음)
ENGINE=openai
# 번역 음성 생성 on | off (off면 앱이 기기 TTS로 읽음)
TRANSLATION_AUDIO=on
# 동시 번역 세션 수, 추론 강도(minimal|low|medium|high), 음성
TRANSLATION_CONCURRENCY=4
TRANSLATION_REASONING=low
TRANSLATION_VOICE=marin
# 1:1 통화·현장 전체 연결 스트리밍 통역 on | off, 동시 엔진 연결 상한(현장 전체 연결은 말하는 사람 × 다른 언어 수), OpenAI 말 끝 무음(ms) (docs/streaming-plan.md)
STREAMING=on
STREAM_MAX_SESSIONS=8
STREAM_VAD_SILENCE_MS=350
# 전사 전용 세션 on | off (on: 원문 자막을 번역과 따로 말 끝 직후에, 번역 세션의 전사는 끔), 엔진 이벤트 추적 0 | 1
STREAM_LIVE_TRANSCRIPTION=on
STREAM_DEBUG=0
# 스트리밍 통화용 서버 노이즈 필터 (조각 단위, src/plugins/streamAudioFilter.ts)
STREAM_AUDIO_FILTER=passthrough
# STREAM_AUDIO_FILTER=sidecar 일 때 노이즈 필터 사이드카 주소 (docs/denoise-sidecar.md, 비우면 ws://denoise:8765)
DENOISE_URL=

# ─── 저장소 ─────────────────────────────────────────
# 업로드 음성·번역 음성(WAV) 저장 위치
STORAGE_DIR=./storage
# 음성 URL 서명 키 (비우면 서버 시작마다 새로 생성)
AUDIO_URL_SECRET=

# ─── 플러그인 ───────────────────────────────────────
# 노이즈 필터: passthrough (다른 개발자의 구현을 src/plugins/audioPreprocessor.ts 에 등록)
AUDIO_PREPROCESSOR=passthrough
# 현장 데이터셋: legacy-workplace | normalized-json
DATASET_ADAPTER=legacy-workplace
DATASET_PATH=./data/legacy-workplace
# 데이터 보존 정책: noop (src/plugins/retentionPolicy.ts 에 등록), 매일 실행 시각(서버 로컬 시간)
RETENTION_POLICY=noop
RETENTION_RUN_AT=03:00

# ─── Supabase (인증 전용) ────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# 서버 전용 비밀 키. 앱에 절대 넣지 말 것 (현재 미사용)
SUPABASE_SECRET_KEY=
