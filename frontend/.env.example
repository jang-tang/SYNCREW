# SYNCREW 서버 주소
# - Android 에뮬레이터: http://10.0.2.2:4000
# - 실제 휴대폰(같은 Wi-Fi): http://<이 컴퓨터의 LAN IP>:4000
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000

# Supabase 인증 (공개용 publishable key만. secret key는 절대 넣지 말 것)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# mock: 서버 없이 데모 데이터로 동작 / live: Supabase 인증 + SYNCREW 서버
EXPO_PUBLIC_API_MODE=mock
